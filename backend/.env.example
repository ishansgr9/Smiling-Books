# Smiling Books Digital Library Backend Configuration Example
PORT=8080
DATABASE_URL=postgres://username:password@hostname:5432/dbname?sslmode=require
JWT_SECRET=generate_a_random_32_character_signing_key_here
FRONTEND_URL=http://localhost:5173

# Storage Mode: Set to true for local directory, set to false for Cloudflare R2
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_DIR=./storage

# Cloudflare R2 Credentials (Only required if USE_LOCAL_STORAGE=false)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
