# =====================================================================
# SMILING BOOKS DIGITAL LIBRARY - MASTER ENVIRONMENT VARIABLES CONFIG
# An initiative of Akshar Paaul NGO
# =====================================================================
#
# This root configuration file lists all environment variables required
# across Backend (Go REST API), Frontend (React Vite SPA), Database (Neon DB),
# and Object Storage (Cloudflare R2).

# ---------------------------------------------------------------------
# 1. BACKEND SERVICE CONFIGURATION (Go REST Server)
# ---------------------------------------------------------------------
# Port number for the Go HTTP backend server (Default: 8080)
PORT=8080

# PostgreSQL Connection String (Neon DB or local PostgreSQL)
# Format: postgres://username:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=postgres://alex_owner:Secr3tPass@ep-cool-mountain-a5xyz.ap-south-1.aws.neon.tech/neondb?sslmode=require

# JWT Secret Key for signing administrator authentication tokens (Minimum 32 random characters)
JWT_SECRET=super_secret_jwt_signing_key_change_this_in_production_32chars!

# Frontend Application URL (Used by Backend CORS Middleware to allow requests)
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------
# 2. OBJECT STORAGE CONFIGURATION (Cloudflare R2 / Local Disk)
# ---------------------------------------------------------------------
# Storage Mode:
# Set to 'true' for local disk development (saves files to LOCAL_STORAGE_DIR)
# Set to 'false' for production Cloudflare R2 bucket storage
USE_LOCAL_STORAGE=true

# Directory path for local file storage (Used when USE_LOCAL_STORAGE=true)
LOCAL_STORAGE_DIR=./storage

# Cloudflare R2 Credentials (Required when USE_LOCAL_STORAGE=false)
# Obtain these from Cloudflare Dashboard -> R2 Object Storage -> Manage R2 API Tokens
R2_ACCOUNT_ID=6a89c02d1e2f3a4b5c6d7e8f90a1b2c3
R2_ACCESS_KEY_ID=8f2a1b3c4d5e6f7a8b9c0d1e2f3a4b5c
R2_SECRET_ACCESS_KEY=99ef4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7f
R2_BUCKET_NAME=smiling-books-storage
R2_ENDPOINT=https://6a89c02d1e2f3a4b5c6d7e8f90a1b2c3.r2.cloudflarestorage.com

# ---------------------------------------------------------------------
# 3. FRONTEND APPLICATION CONFIGURATION (React + Vite SPA)
# ---------------------------------------------------------------------
# Base API URL where the frontend makes REST request calls
# For local dev: http://localhost:8080
# For production: https://smiling-books-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8080
